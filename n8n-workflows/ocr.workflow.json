    {
      "id": "f969d5a1-6cd1-4f96-b23b-33d7822119dc",
      "name": "Gemini OCR - URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1260,
        220
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini API"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [ { inline_data: { mime_type: $binary.imageData.mimeType || 'image/jpeg', data: $binary.imageData.data } }, { text: 'Extract all readable text from this educational note image. Preserve headings, mathematical formulas, diagram labels, bullet points and numbering. Return plain text only, no markdown.' } ] }] }) }}",
        "options": {}
      }
    },
    {
      "id": "bf3fc116-ba2e-41a6-853c-1d9474fb5c3a",
      "name": "Gemini OCR - Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1010,
        420
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini API"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [ { inline_data: {   mime_type: ($('Webhook - OCR').item.json.body || $('Webhook - OCR').item.json).mimeType || 'image/jpeg',   data: (($('Webhook - OCR').item.json.body || $('Webhook - OCR').item.json).imageBase64 || '').replace(/^data:[^,]+,/, '') }}, { text: 'Extract all readable text from this educational note image. Preserve headings, mathematical formulas, diagram labels, bullet points and numbering. Return plain text only, no markdown.' } ] }] }) }}",
        "options": {}
      }
    },
    {
      "id": "cb8500fa-bccf-4db5-8df8-080ebd69aa49",
      "name": "Code - Format Pasted Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1010,
        620
      ],
      "parameters": {
        "jsCode": "// Text path \u2013 student pasted raw text, no OCR needed\nconst body = $('Webhook - OCR').item.json.body || $('Webhook - OCR').item.json;\nreturn [{ json: {\n  noteId        : body.noteId,\n  userId        : body.userId,\n  rawText       : body.extractedText || '',\n  inputType     : 'text',\n  source        : 'paste'\n} }];"
      }
    },
    {
      "id": "59dc1471-e30f-40ad-96ab-d29d3dbc76ec",
      "name": "Code - Clean OCR Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1510,
        420
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body  = $('Webhook - OCR').item.json.body || $('Webhook - OCR').item.json;\n\n// \u2500\u2500 Detect which path delivered this item \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlet rawText = '';\nlet source  = item.source || 'unknown';\n\nif (item.rawText !== undefined) {\n  // Text (paste) path \u2013 rawText already normalised\n  rawText = item.rawText;\n  source  = 'paste';\n} else if (item.candidates) {\n  // Gemini response (URL or Upload path)\n  rawText = item.candidates?.[0]?.content?.parts?.[0]?.text || '';\n  source  = item.source || 'gemini-ocr';\n}\n\n// \u2500\u2500 Clean \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst cleaned = rawText\n  .replace(/\\r\\n|\\r/g, '\\n')\n  .replace(/[ \\t]{2,}/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .replace(/- \\n/g, '')\n  .trim();\n\nreturn [{ json: {\n  noteId        : body.noteId || item.noteId,\n  userId        : body.userId || item.userId,\n  extractedText : cleaned,\n  wordCount     : cleaned.split(/\\s+/).filter(Boolean).length,\n  inputType     : body.inputType || item.inputType || 'unknown',\n  source\n} }];"
      }
    },
    {
      "id": "15fe1af3-5692-46f9-815f-b802192b70a8",
