{
  "name": "Learnify \u2013 04 Weekly Report",
  "nodes": [
    {
      "id": "17602839-8c95-4965-a1e6-fccde123d901",
      "name": "Pipeline Info",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        -20
      ],
      "parameters": {
        "content": "## \ud83d\udcca Weekly Report Pipeline\n\n**Trigger:** Cron \u2013 runs every Monday at 08:00\n\nFetches all student performance data from backend, generates\na Gemini AI summary, and saves it back to the backend.\n\n**Env vars needed:**\n- `GOOGLE_PALM_API` credential\n- `backendUrl` in Set Config node",
        "height": 280,
        "width": 460,
        "color": 7
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 18
            }
          ]
        }
      },
      "id": "f5e3fb5f-770b-4328-83b3-996262c415a4",
      "name": "Cron - Weekly Report",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfc85acd-7430-42fa-875a-66d94d991a9c",
              "name": "backendUrl",
              "value": "https://your-backend-url.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b6d3e52a-8ee3-459c-bf8e-f4df41ea531d",
      "name": "Set Config - Weekly Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        510,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Set Config - Weekly Report').item.json.backendUrl + '/api/admin/weekly-report-data' }}",
        "options": {}
      },
      "id": "167e63af-e6ce-41c2-8cf0-9ff66999b759",
      "name": "Backend - Fetch Weekly Report Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: 'Create a concise weekly Learnify student performance report from this JSON data. Include weak topics, mastered topics, study recommendations, and next steps. Data: ' + JSON.stringify($json) }] }] }) }}",
        "options": {}
      },
      "id": "f88214b4-3f96-4ea6-b207-e72498f1a9c6",
      "name": "Gemini Credential - Weekly Report Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1010,
        300
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Config - Weekly Report').item.json.backendUrl + '/api/admin/weekly-report-result' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ report: $json.candidates?.[0]?.content?.parts?.[0]?.text || 'No report generated' }) }}",
        "options": {}
      },
      "id": "fd6d2a44-3470-41a2-903a-4eb0da47ee85",
      "name": "Backend - Save Weekly Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1260,
        300
      ]
    }
  ],
  "connections": {
    "Cron - Weekly Report": {
      "main": [
        [
          {
            "node": "Set Config - Weekly Report",
