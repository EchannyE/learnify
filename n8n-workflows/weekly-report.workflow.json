            "index": 0
          }
        ]
      ]
    },
    "Gemini Credential - Weekly Report Summary": {
      "main": [
        [
          {
            "node": "Backend - Save Weekly Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
